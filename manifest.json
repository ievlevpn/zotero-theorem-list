{
	"manifest_version": 2,
	"name": "Theorem List",
	"version": "0.7.2",
	"description": "Adds a button to the PDF reader toolbar that lists theorems, lemmas, propositions and corollaries, with click-to-jump.",
	"homepage_url": "https://github.com/ievlevpn/zotero-theorem-list",
	"author": "Pavel Ievlev",
	"icons": {
		"48": "icon.svg",
		"96": "icon.svg"
	},
	"applications": {
		"zotero": {
			"id": "theorem-list@local",
			"update_url": "https://raw.githubusercontent.com/ievlevpn/zotero-theorem-list/master/update.json",
			"strict_min_version": "6.999",
			"strict_max_version": "10.0.*"
		}
	}
}
